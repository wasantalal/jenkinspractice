pipeline {
    agent any

    environment {
        DOCKER_IMAGE = "wasantalal/doc_env:latest"
        DOCKERHUB_CREDENTIALS = "395b0174-e472-49eb-b75a-15b55d0dab4d"
        GITHUB_REPO = "https://github.com/wasantalal/jenkinspractice.git"
        
        // Secret files for cosign keys
        COSIGN_PRIVATE_KEY = credentials('cosign-private-key')
        COSIGN_PUBLIC_KEY = credentials('cosign-public-key')
        COSIGN_PASSWORD = credentials('cosign-password')
    }

    stages {

        stage('Get Code From GitHub') {
            steps {
                echo "Cloning repository..."
                git branch: 'main', url: "${GITHUB_REPO}"
            }
        }

        stage('Build Docker Image') {
            steps {
                echo "Building Docker Image using native Docker commands..."
                bat """
                    docker build -t %DOCKER_IMAGE% .
                """
            }
        }

        stage('Login to DockerHub') {
            steps {
                echo "Logging into DockerHub..."
                script {
                    bat """
                        echo %DOCKERHUB_CREDENTIALS_PSW% | docker login --username %DOCKERHUB_CREDENTIALS_USR% --password-stdin
                    """
                }
            }
        }

        stage('Push Image to DockerHub') {
            steps {
                echo "Pushing image to DockerHub..."
                bat """
                    docker push %DOCKER_IMAGE%
                """
            }
        }

        stage('Sign Image with Cosign') {
            steps {
                echo "Signing Docker image with Cosign private key..."
                script {
                    // Note: We're already logged into DockerHub from previous stage
                    bat """
                        echo %COSIGN_PASSWORD% | cosign sign --key "%COSIGN_PRIVATE_KEY%" ^
                            %DOCKER_IMAGE%
                    """
                }
            }
        }

        stage('Verify Signature with Cosign') {
            steps {
                echo "Verifying image signature with Cosign public key..."
                script {
                    bat """
                        cosign verify --key "%COSIGN_PUBLIC_KEY%" ^
                            %DOCKER_IMAGE%
                    """
                }
            }
        }

    }

    post {
        success {
            echo "Pipeline completed successfully! Image built, pushed, signed, and verified."
        }
        failure {
            echo "Pipeline failed."
        }
        always {
            script {
                // Logout from DockerHub
                bat """
                    docker logout
                """
            }
        }
    }
}
