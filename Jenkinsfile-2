pipeline {
    agent any

    environment {
        DOCKER_IMAGE = "wasantalal/doc_env:latest"
        DOCKERHUB_CREDENTIALS = "395b0174-e472-49eb-b75a-15b55d0dab4d"
        GITHUB_REPO = "https://github.com/wasantalal/jenkinspractice.git"
        COSIGN_PRIVATE_KEY = credentials('cosign-private-key')
        COSIGN_PUBLIC_KEY = credentials('cosign-public-key')
        COSIGN_PASSWORD = credentials('cosign-password')
    }

    stages {

        stage('Get Code From GitHub') {
            steps {
                echo "Cloning repository..."
                git branch: 'main', url: "${GITHUB_REPO}"
            }
        }

        stage('Build Docker Image') {
            steps {
                echo "Building Docker Image using native Docker commands..."
                bat """
                    docker build -t %DOCKER_IMAGE% .
                """
            }
        }

stage('Verify Cosign Installation') {
    steps {
        bat """
            where cosign
            cosign version
        """
    }
}

        stage('Sign Image with Cosign') {
            steps {
                echo "Signing Docker image with Cosign private key..."
                script {
                    // Write private key to file
                    bat """
                        echo %COSIGN_PRIVATE_KEY% > cosign.key
                    """
                    
                    // Sign the image - removed the icacls command completely
                    bat """
                        echo %COSIGN_PASSWORD% | cosign sign --key cosign.key ^
                            %DOCKER_IMAGE%
                    """
                    
                    // Clean up private key
                    bat """
                        del cosign.key
                    """
                }
            }
        }

        stage('Push to DockerHub') {
            steps {
                echo "Logging into DockerHub and pushing image..."
                script {
                    bat """
                        echo %DOCKERHUB_CREDENTIALS_PSW% | docker login ^
                            -u %DOCKERHUB_CREDENTIALS_USR% ^
                            --password-stdin
                        docker push %DOCKER_IMAGE%
                    """
                }
            }
        }

        stage('Verify Signature with Cosign') {
            steps {
                echo "Verifying image signature with Cosign public key..."
                script {
                    // Write public key to file
                    bat """
                        echo %COSIGN_PUBLIC_KEY% > cosign.pub
                    """
                    
                    // Verify the signature
                    bat """
                        cosign verify --key cosign.pub ^
                            %DOCKER_IMAGE%
                    """
                    
                    // Clean up public key
                    bat """
                        del cosign.pub
                    """
                }
            }
        }

    }

    post {
        success {
            echo "Pipeline completed successfully! Image built, signed, pushed, and verified."
        }
        failure {
            echo "Pipeline failed."
        }
    }
}
